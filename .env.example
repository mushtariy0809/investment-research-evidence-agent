# Copy this file to .env and fill in real values. Never commit .env.

# --- LLM provider ---
# "mock" runs the full pipeline deterministically with no API key (default).
# "anthropic" uses the real Anthropic API.
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- SEC EDGAR fair-access policy ---
# SEC requires a declared User-Agent identifying your app and a contact email.
# https://www.sec.gov/os/accessing-edgar-data
SEC_USER_AGENT_NAME=InvestmentResearchEvidenceAgent
SEC_CONTACT_EMAIL=you@example.com

# --- Database ---
# SQLite for local dev; swap to postgresql+psycopg://user:pass@host/db later.
DATABASE_URL=sqlite:///./data/app.db

# --- App ---
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
